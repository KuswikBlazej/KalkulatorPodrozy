<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kalkulator Podróży"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:gravity="center"
        android:padding="10dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Autor: 00000000000"
        android:textSize="16sp"
        android:gravity="center"
        android:textColor="#555555"
        android:paddingBottom="20dp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dystans w km"
        android:textSize="16sp" />
    <EditText
        android:id="@+id/dystans"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Dystans (km)"
        android:inputType="numberDecimal"
        android:padding="12dp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Złużycie paliwa na 100km"
        android:textSize="16sp" />
    <EditText
        android:id="@+id/spalanie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Średnie spalanie (l/100 km)"
        android:inputType="numberDecimal"
        android:padding="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rodzaj paliwa:"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:paddingTop="15dp"/>

    <RadioGroup
        android:id="@+id/grupaPaliwa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/benzyna"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Benzyna (6,50 zł/l)"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/diesel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Diesel (6,70 zł/l)"/>

        <RadioButton
            android:id="@+id/lpg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LPG (3,10 zł/l)"/>

    </RadioGroup>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Liczba pasażerów"
        android:textSize="16sp" />
    <EditText
        android:id="@+id/pasazerowie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Liczba pasażerów"
        android:inputType="number"
        android:text="1"
        android:padding="12dp"/>

    <Button
        android:id="@+id/oblicz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="OBLICZ KOSZT"
        android:textSize="16sp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#2196F3"
        android:textColor="#FFFFFF"/>

    <TextView
        android:id="@+id/wynik"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="20dp"/>

</LinearLayout>
